# Identa: variáveis de ambiente
# Copie para .env e preencha. As marcadas [obrigatória] impedem a API de subir se faltarem.
# Os valores entre colchetes no fim de cada descrição são o padrão.
# Detalhes de cada item em docs/configuracao.md.

# --- Docker Compose ----------------------------------------------------------
# Endereço e porta em que a interface fica acessível no host. Use 0.0.0.0 para a rede local. [127.0.0.1]
IDENTA_BIND=127.0.0.1
# Porta da interface no host. [8090]
IDENTA_PORT=8090
# Banco PostgreSQL criado pelo Compose. As senhas ficam em secrets/ (rode scripts/gerar-segredos.sh).
POSTGRES_DB=identa
POSTGRES_USER=identa
# Usuário sem privilégios com que a API acessa o banco. [identa_app]
POSTGRES_APP_USER=identa_app
# Limites de memória dos containers. [3g, 512m, 1g]
IDENTA_API_MEMORY_LIMIT=3g
IDENTA_WEB_MEMORY_LIMIT=512m
POSTGRES_MEMORY_LIMIT=1g
# Porta do PostgreSQL no host, só no modo GPU (docker-compose.gpu.yml), sempre em 127.0.0.1. [5432]
POSTGRES_HOST_PORT=5432
# Porta do painel do Mailpit (perfil dev), sempre em 127.0.0.1. [8025]
MAILPIT_PORT=8025
# Porta SMTP do Mailpit no host, para a API rodando fora do Docker. [1025]
MAILPIT_SMTP_PORT=1025

# --- Segredos ----------------------------------------------------------------
# No Compose os segredos vêm de secrets/ e estas variáveis ficam vazias.
# Qualquer variável aceita a forma _FILE, por exemplo IDENTA_SECRET_KEY_FILE=/run/secrets/secret_key.
# [obrigatória] Assina os cookies de sessão e protege o segredo do 2FA. Mínimo de 32 caracteres.
# Gere com: python -m identa.cli generate-key
IDENTA_SECRET_KEY=
# Criptografia das imagens em repouso (AES-256-GCM). [true]
IDENTA_ENCRYPTION_ENABLED=true
# [obrigatória com criptografia ligada] Chave AES de 32 bytes em base64. Gere com: python -m identa.cli generate-key
# Perder esta chave significa perder as imagens.
IDENTA_ENCRYPTION_KEY=
# Chaves anteriores, separadas por vírgula, usadas só para ler o que ainda não foi recifrado.
# Depois de trocar a chave, rode: python -m identa.cli reencrypt []
IDENTA_ENCRYPTION_OLD_KEYS=

# --- Banco e armazenamento (fora do Compose) ---------------------------------
# sqlite:///caminho.db ou postgresql://usuario:senha@host:5432/banco.
# No Compose é montada a partir das variáveis POSTGRES_*. [sqlite:///./data/identa.db]
IDENTA_DATABASE_URL=sqlite:///./data/identa.db
# Senha do PostgreSQL quando ela não está na URL. Substitui a da URL. []
IDENTA_DATABASE_PASSWORD=
# Pasta das imagens. No Compose é um volume em /data/storage. [./storage]
IDENTA_STORAGE_DIR=./storage
# Pasta do host montada em /data/storage no Docker e usada pela API nativa no modo GPU. [./storage]
IDENTA_STORAGE_PATH=./storage
# Endereço público usado nos links de convite, verificação e redefinição de senha.
# Vazio usa o endereço da requisição. Exemplo: http://192.168.0.10:8090 []
IDENTA_PUBLIC_URL=

# --- E-mail (SMTP) -----------------------------------------------------------
# Sem SMTP_HOST, convites e links de redefinição aparecem para o administrador copiar. []
# Para o Mailpit do perfil dev: IDENTA_SMTP_HOST=mailpit, IDENTA_SMTP_PORT=1025, IDENTA_SMTP_SECURITY=none.
IDENTA_SMTP_HOST=
# [587]
IDENTA_SMTP_PORT=587
# starttls, ssl ou none. [starttls]
IDENTA_SMTP_SECURITY=starttls
IDENTA_SMTP_USER=
IDENTA_SMTP_PASSWORD=
# [obrigatória com SMTP_HOST] Remetente, por exemplo identa@suaempresa.com.br
IDENTA_SMTP_FROM=

# --- OCR ---------------------------------------------------------------------
# rapidocr ou tesseract. [rapidocr]
IDENTA_OCR_ENGINE=rapidocr
# auto, cpu ou gpu. auto testa a GPU e usa a CPU se ela falhar ou for mais lenta. No Docker é cpu. [auto]
IDENTA_OCR_DEVICE=auto
# Idiomas do Tesseract (códigos do Tesseract separados por +). O RapidOCR usa o modelo latino. [por]
IDENTA_OCR_LANGUAGES=por
# Pasta dos modelos ONNX. No Docker os modelos já vêm na imagem. [./models]
IDENTA_OCR_MODEL_DIR=./models
# Prepara o motor de OCR ao subir a API. [true]
IDENTA_OCR_WARMUP=true
# Leituras da mesma imagem com efeitos (contraste, nitidez, preto e branco), de 1 a 4.
# As extras só rodam quando algum campo vem vazio, inválido ou com confiança abaixo de 90%. [3]
IDENTA_OCR_PASSES=3

# --- Envio e imagens ---------------------------------------------------------
# Tamanho máximo por imagem, de 1 a 100 MB. [15]
IDENTA_UPLOAD_MAX_MB=15
# Formatos aceitos, separados por vírgula: jpeg, png, webp, heic. [jpeg,png,webp,heic]
IDENTA_UPLOAD_FORMATS=jpeg,png,webp,heic
# Qualidade JPEG das imagens processadas e recortes, de 40 a 100. [88]
IDENTA_IMAGE_QUALITY=88
# Recomprimir o original em JPEG (remove metadados e reduz o tamanho). [false]
IDENTA_COMPRESS_ORIGINALS=false
# Maior lado do original recomprimido, em pixels. [3000]
IDENTA_ORIGINAL_MAX_SIDE=3000

# --- Retenção ----------------------------------------------------------------
# Apaga documentos processados há mais de N dias. 0 desliga. [0]
IDENTA_RETENTION_DAYS=0
# Intervalo entre as verificações de retenção, em horas. [24]
IDENTA_RETENTION_INTERVAL_HOURS=24
# Tarefas em segundo plano (retenção e preparo do OCR). [true]
IDENTA_BACKGROUND_JOBS=true

# --- Senhas e sessões --------------------------------------------------------
# Tamanho mínimo da senha, de 8 a 128. [10]
IDENTA_PASSWORD_MIN_LENGTH=10
# Exigir letras misturadas com números ou símbolos. [true]
IDENTA_PASSWORD_REQUIRE_MIXED=true
# Tentativas erradas antes do bloqueio temporário da conta. [5]
IDENTA_LOGIN_MAX_ATTEMPTS=5
# Duração do bloqueio temporário, em minutos. [15]
IDENTA_LOGIN_LOCK_MINUTES=15
# Validade do cookie de acesso, em minutos. Renovado pelo refresh token. [15]
IDENTA_ACCESS_MINUTES=15
# Duração máxima de uma sessão desde o login, em dias. Renovar não estende esse prazo. [30]
IDENTA_REFRESH_DAYS=30
# Sessão sem uso por mais que isto exige novo login, em horas. [12]
IDENTA_SESSION_IDLE_HOURS=12
# Validade do convite, em horas. [72]
IDENTA_INVITE_HOURS=72
# Validade do link de redefinição de senha, em minutos. [60]
IDENTA_RESET_MINUTES=60
# Validade do link de confirmação de e-mail, em horas. [48]
IDENTA_VERIFY_HOURS=48
# Validade padrão do link de envio remoto, em horas. [48]
IDENTA_SCAN_LINK_HOURS=48
# Cookies só por HTTPS. Ligue quando houver TLS na frente. [false]
IDENTA_SECURE_COOKIES=false
# Modo produção: a API não sobe sem IDENTA_SECURE_COOKIES=true, IDENTA_PUBLIC_URL com https://,
# criptografia ligada e SMTP com TLS. Use em qualquer instalação acessível pela internet. [false]
IDENTA_PRODUCTION=false

# --- Instância e interface ---------------------------------------------------
# Nome exibido no menu, no login e nos e-mails. [Identa]
IDENTA_INSTANCE_NAME=Identa
# Tema padrão: system, light ou dark. [system]
IDENTA_DEFAULT_THEME=system
# Idioma padrão da interface: pt-BR ou en. [pt-BR]
IDENTA_DEFAULT_LANGUAGE=pt-BR
# Fuso horário das datas exibidas. [America/Sao_Paulo]
IDENTA_TIMEZONE=America/Sao_Paulo

# --- Interface web (apps/web) ------------------------------------------------
# Endereço interno da API para o proxy do Next. Lido no build e na execução. [http://127.0.0.1:8000]
IDENTA_API_URL=http://127.0.0.1:8000
